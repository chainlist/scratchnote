{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Scratchnote",
  "version": "0.7.0",
  "identifier": "com.scratchnote.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scratchnote",
        "width": 800,
        "height": 600,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCQkFERTUxQThDQTJEM0YKUldRL0xjcW9VZDY2eTZ5a3lBL0xlRFZjT1lucW5lR0IrMG9pQmgxSk04TFBsaUFNTWVZdEEzak4K",
      "endpoints": [
        "https://github.com/chainlist/scratchnote/releases/latest/download/latest.json"
      ]
    }
  }
}